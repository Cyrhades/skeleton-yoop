{
    "name": "yoop/skeleton",
    "type": "project",
    "license": "MIT",
    "description": "Squelette pour création d'une web application avec Yoop",
    "minimum-stability": "dev",
    "autoload" : {
        "psr-4" : {
            "App\\" : "src/"     
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Cyrhades/yoop.git"
        }
    ],
    "require": {
        "cyrhades/yoop": "dev-master",
        "twig/twig": "^3.0",
        "nikic/fast-route": "^1.3" 
    },
    "require-dev": {
        "symfony/var-dumper": "^5.1"
    }
}
